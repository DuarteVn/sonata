{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings window: the usage commands (feature 006), revealing a path, and the Kimi integration (feature 010).",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "allow-app-reveal-path",
    "allow-usage-state",
    "allow-usage-refresh",
    "allow-usage-set-enabled",
    "allow-usage-set-warnings",
    "allow-usage-set-provider-enabled",
    "allow-usage-set-provider-color",
    "allow-usage-answer-consent",
    "allow-usage-providers-folder",
    "allow-kimi-integration",
    "allow-kimi-integration-apply",
    "allow-kimi-integration-remove",
    "allow-kimi-watch"
  ],
  "webviews": [
    "settings"
  ]
}
