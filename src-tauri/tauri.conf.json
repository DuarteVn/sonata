{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonata",
  "version": "0.2.0",
  "identifier": "dev.sonata.app",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sonata",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-"
    },
    "resources": {
      "resources/bin/": "bin/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2Qjk2MzdBNzA3NzE0RkMKUldUOEZIZHdlbU81aHJLY1ZuZVhGdk5pQ3JPVUI0a2J3eEYybkN2a0JUZTcyc2R1cTJ1b2E3aHgK",
      "endpoints": [
        "https://github.com/DuarteVn/sonata/releases/latest/download/latest.json"
      ]
    }
  }
}
